    {
     "icon": "button/rename",
     "width": 22,
     "height": 22
    },
    {
     "icon": "button/reset",
     "width": 22,
     "height": 22
    },
    {
     "icon": "button/random",
     "width": 22,
     "height": 22
    }
   ]
  },
  {
   "repeat": "slots",
   "as": "slot",
   "max": 6,
   "layout": {
    "grid": {
     "x": 8,
     "y": 41,
     "cell": [
      146,
      105
     ],
     "gap": 3,
     "columns": 3
    }
   },
   "children": [
    {
     "when": "{slot.enabled}",
     "then": [
      {
       "box": "raised",
       "width": 146,
       "height": 105
      },
      {
       "text": "{slot.label}",
       "x": 6,
       "y": 12,
       "style": "heading"
      },
      {
       "when": "{slot.icon}",
       "then": [
        {
         "icon": "{slot.icon}",
         "x": 108,
         "y": 4,
         "width": 32,
         "height": 32,
         "tooltip": "{slot.tip}"
        }
       ],
       "else": [
        {
         "icon": "button/unknown",
         "x": 108,
         "y": 4,
         "width": 32,
         "height": 32
        }
       ]
      },
      {
       "text": "{slot.equipped}",
       "x": 6,
       "y": 36,
       "width": 134,
       "wrap": true,
       "max_lines": 1,
       "style": "muted"
      },
      {
       "when": "{slot.rows == 1}",
       "then": [
        {
         "use": "tile_row",
         "x": 0,
         "y": 63,
         "with": {
          "tiles": "{slot.row1}",
          "slot": "{slot.type}",
          "count": "{slot.row1Count}"
         }
        }
       ],
       "else": [
        {
         "use": "tile_row",
         "x": 0,
         "y": 45,
         "with": {
          "tiles": "{slot.row1}",
          "slot": "{slot.type}",
          "count": "{slot.row1Count}"
         }
        },
        {
         "use": "tile_row",
         "x": 0,
         "y": 72,
         "with": {
          "tiles": "{slot.row2}",
          "slot": "{slot.type}",
          "count": "{slot.row2Count}"
         }
        }
       ]
      }
     ],
     "else": [
      {
       "box": "disabled",
       "width": 146,
       "height": 105
      },
      {
       "text": "{slot.label}",
       "x": 6,
       "y": 12,
       "style": "heading"
      },
      {
       "text": {
        "key": "champions.menu.editor.slot.empty"
       },
       "x": 6,
       "y": 36,
       "width": 134,
       "wrap": true,
       "max_lines": 3,
       "style": "muted"
      }
     ]
    }
   ]
  }
 ],
 "exit": {
  "label": {
   "key": "champions.menu.screen.back"
  },
  "width": 80,
