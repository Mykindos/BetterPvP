   "y": 8,
   "width": 460,
   "height": 256
  },
  {
   "custom": "core:text_icons",
   "x": 9,
   "y": 0,
   "properties": {
    "text": "{name}",
    "style": "title",
    "text_y": 18,
    "gap": 8,
    "spacing": 4,
    "icons": [
     {
      "sprite": "button/rename",
      "width": 22,
      "height": 22,
      "y": 10,
      "tooltip": "champions.menu.editor.rename",
      "action": "rename"
     },
     {
      "sprite": "button/reset",
      "width": 22,
      "height": 22,
      "y": 10,
      "tooltip": "champions.menu.editor.reset",
      "action": "reset"
     },
     {
      "sprite": "button/random",
      "width": 22,
      "height": 22,
      "y": 10,
      "tooltip": "champions.menu.editor.randomize",
      "action": "randomize"
     }
    ]
   },
