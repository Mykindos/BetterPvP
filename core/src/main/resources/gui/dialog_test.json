{
  "$schema": "schema/screen.schema.json",
  "canvas": { "width": 440, "height": 205 },
  "name": { "key": "core.dialog.test.name" },
  "state": { "tab": "overview", "clicks": 0, "rewards": [], "picked": null },
  "backdrop": [
    { "box": "panel", "x": 0, "y": 0, "width": 440, "height": 205 },
    { "box": "header", "x": 1, "y": 1, "width": 438, "height": 22 },
    { "box": "well", "x": 8, "y": 30, "width": 258, "height": 167 },
    { "box": "raised", "x": 274, "y": 30, "width": 158, "height": 167 }
  ],
  "elements": [
    {
      "row": { "x": 8, "y": 5, "cell": [70, 14], "gap": 4 },
      "children": [
        { "button": "tab", "selected_style": "tab_selected", "selected": "{tab == 'overview'}", "width": 70, "height": 14,
          "label": { "key": "core.dialog.test.tab.1" }, "selected_label_style": "on_primary",
          "tooltip": { "key": "core.dialog.test.tab.tooltip" }, "on_click": { "set": { "tab": "overview" } } },
        { "button": "tab", "selected_style": "tab_selected", "selected": "{tab == 'details'}", "width": 70, "height": 14,
          "label": { "key": "core.dialog.test.tab.2" }, "selected_label_style": "on_primary", "tooltip": { "key": "core.dialog.test.tab.tooltip" },
          "on_click": { "set": { "tab": "details" } } },
        { "button": "tab", "selected_style": "tab_selected", "selected": "{tab == 'rewards'}", "width": 70, "height": 14,
          "label": { "key": "core.dialog.test.tab.3" }, "selected_label_style": "on_primary", "tooltip": { "key": "core.dialog.test.tab.tooltip" },
          "on_click": { "set": { "tab": "rewards" } } }
      ]
    },
    {
      "switch": "{tab}",
      "cases": {
        "overview": [
          { "text": { "key": "core.dialog.test.tab.1" }, "x": 16, "y": 38, "style": "title" },
          { "text": { "key": "core.dialog.test.description.1" }, "x": 16, "y": 54, "style": "muted" },
          { "text": { "key": "core.dialog.test.clicks", "args": ["{clicks}"] }, "x": 16, "y": 74 }
        ],
        "details": [
          { "text": { "key": "core.dialog.test.tab.2" }, "x": 16, "y": 38, "style": "title" },
          { "text": { "key": "core.dialog.test.description.2" }, "x": 16, "y": 54, "style": "muted" },
          { "icon": "coin_spin", "x": 16, "y": 74, "width": 16, "height": 16, "frames": 8, "fps": 10 }
        ],
        "rewards": [
          { "text": { "key": "core.dialog.test.tab.3" }, "x": 16, "y": 38, "style": "title" },
          {
            "repeat": "rewards", "max": 4,
            "layout": { "grid": { "x": 16, "y": 56, "cell": [118, 18], "gap": 4, "columns": 2 } },
            "children": [
              { "button": "normal", "width": 118, "height": 18, "label": "{item}", "hover": "rim", "pressed": true,
                "on_click": { "set": { "picked": "{item}" } } }
            ]
          },
          { "text": { "key": "core.dialog.test.description.3" }, "x": 16, "y": 104, "style": "muted" }
        ]
      }
    },
    { "when": "{picked && tab == 'rewards'}", "then": [ { "text": "{picked}", "x": 16, "y": 120, "style": "value" } ] },
    { "button": "normal", "x": 282, "y": 154, "width": 142, "height": 16, "label": { "key": "core.dialog.test.tab.2" },
      "hover": "rim", "pressed": true, "on_click": { "set": { "tab": "details" } } },
    { "button": "primary", "x": 282, "y": 174, "width": 142, "height": 18, "label": { "key": "core.dialog.test.confirm" },
      "label_style": "on_primary", "hover": "rim", "pressed": true, "on_click": { "set": { "clicks": "{clicks + 1}" } } }
  ],
  "exit": { "label": { "key": "core.dialog.test.close" }, "tooltip": { "key": "core.dialog.test.close.tooltip" }, "width": 150 }
}
